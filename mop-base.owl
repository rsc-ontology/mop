    <!-- http://purl.obolibrary.org/obo/MOP_0000686 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOP_0000686">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOP_0000629"/>
        <obo:IAO_0000115>A polymerisation in which a cyclic monomer yields a monomeric unit which is acyclic or contains fewer cycles than the monomer. If the monomer is polycyclic, the opening of a single ring is sufficient to classify the reaction as a ring-opening polymerisation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ring-opening polymerization</oboInOwl:hasExactSynonym>
        <oboInOwl:id>MOP:0000686</oboInOwl:id>
        <rdfs:label>ring-opening polymerisation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MOP_0000686"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A polymerisation in which a cyclic monomer yields a monomeric unit which is acyclic or contains fewer cycles than the monomer. If the monomer is polycyclic, the opening of a single ring is sufficient to classify the reaction as a ring-opening polymerisation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1351/goldbook.R05396</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MOP_0000687 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOP_0000687">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOP_0000543"/>
        <obo:IAO_0000115>A molecular process involving the exchange of a bond or bonds between similar interacting chemical species so that the bonding affiliations in the products are identical or closely similar to those in the reactants. An example is where RCH=CHR reacts with R&apos;CH=CHR&apos; to form 2RCH=CHR&apos;.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>metathesis reaction</oboInOwl:hasExactSynonym>
        <oboInOwl:id>MOP:0000687</oboInOwl:id>
        <rdfs:label>metathesis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MOP_0000687"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A molecular process involving the exchange of a bond or bonds between similar interacting chemical species so that the bonding affiliations in the products are identical or closely similar to those in the reactants. An example is where RCH=CHR reacts with R&apos;CH=CHR&apos; to form 2RCH=CHR&apos;.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1351/goldbook.M03878</oboInOwl:hasDbXref>
    </owl:Axiom>
    


