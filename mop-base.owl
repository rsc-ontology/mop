        <dcterms:title>Molecular Process Ontology (MOP)</dcterms:title>
        <oboInOwl:hasOBOFormatVersion>1.2</oboInOwl:hasOBOFormatVersion>
        <owl:versionInfo>2026-09-29</owl:versionInfo>
    </owl:Ontology>
    


