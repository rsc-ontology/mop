        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MOP_0000689"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A living polymerisation process where a transfer agent AX, reacts reversibly with an initiating radical R. or a propagating radical R(M)[n]. to give another transfer agent RX or R(M)[n]X and a species capable of initiating polymerisation.</owl:annotatedTarget>
