    <!-- http://purl.obolibrary.org/obo/MOP_0005561 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOP_0005561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>A formal account of the degree of oxidation of an atom.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>http://goldbook.iupac.org/O04365.html</oboInOwl:hasDbXref>
        <oboInOwl:id>MOP:0005561</oboInOwl:id>
        <rdfs:comment>It turns out to be formally defined, which makes our definitions a bit poor.</rdfs:comment>
        <rdfs:comment>The same term was provided in RXNO under the ID MOP:0000712 which conflicts with the same ID in MOP preserved for olefin reduction. The term was deleted from RXNO to be reimported correctly from MOP iwith the new current ID&quot;)</rdfs:comment>
        <rdfs:label>oxidation state</rdfs:label>
