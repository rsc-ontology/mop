    <!-- http://purl.obolibrary.org/obo/MOP_0000591 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOP_0000591">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOP_0000479"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_46883"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Formation of a covalent bond between a substrate and a carboxy group.</obo:IAO_0000115>
        <oboInOwl:created_by>batchelorc</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-06-05T04:57:07Z</oboInOwl:creation_date>
        <oboInOwl:id>MOP:0000591</oboInOwl:id>
        <rdfs:comment>CHEBI:46883.</rdfs:comment>
        <rdfs:comment>Prior to the resolving of https://github.com/rsc-ontology/rxno/issues/27 this class was wrongly also defined in RXNO under the ID MOP:0000713 (&apos;acetylene reduction&apos;). 
Thus the &quot;has_participant some &apos;carboxy group&apos;&quot; axiom, which was not yet present on &apos;carboxylation&apos; (MOP:0000591) in MOP was copied from this wrongly defined  &apos;carboxylation&apos; in RXNO to the proper one in MOP.

The only RXNO subclass &apos;Kolbe-Schmitt reaction&apos; (RXNO:0000182) of &apos;carboxylation&apos; was also moved to be correctly subsumed in RXNO.</rdfs:comment>
        <rdfs:label>carboxylation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MOP_0000591"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Formation of a covalent bond between a substrate and a carboxy group.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>RSC:xp</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MOP_0000591"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Prior to the resolving of https://github.com/rsc-ontology/rxno/issues/27 this class was wrongly also defined in RXNO under the ID MOP:0000713 (&apos;acetylene reduction&apos;). 
Thus the &quot;has_participant some &apos;carboxy group&apos;&quot; axiom, which was not yet present on &apos;carboxylation&apos; (MOP:0000591) in MOP was copied from this wrongly defined  &apos;carboxylation&apos; in RXNO to the proper one in MOP.

The only RXNO subclass &apos;Kolbe-Schmitt reaction&apos; (RXNO:0000182) of &apos;carboxylation&apos; was also moved to be correctly subsumed in RXNO.</owl:annotatedTarget>
        <oboInOwl:created_by rdf:resource="https://orcid.org/0000-0002-1595-3213"/>
    </owl:Axiom>
    


