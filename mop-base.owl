        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/mop/releases/2026-09-29/mop-base.owl"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/IAO_8000001"/>
        <dcterms:date>01:02:2022 11:15</dcterms:date>
        <dcterms:description>MOP is the molecular process ontology. It contains the molecular processes that underlie the name reaction ontology RXNO, for example cyclization, methylation and demethylation.</dcterms:description>
