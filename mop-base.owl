        <oboInOwl:hasExactSynonym>RAFT polymerization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reversible addition--fragmentation chain transfer polymerization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reversible addition-fragmentation chain transfer polymerisation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reversible addition-fragmentation chain transfer polymerization</oboInOwl:hasExactSynonym>
        <oboInOwl:id>MOP:0000689</oboInOwl:id>
        <rdfs:label>reversible addition-fragmentation chain transfer polymerisation</rdfs:label>
    </owl:Class>
