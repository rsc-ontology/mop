    <!-- http://purl.obolibrary.org/obo/MOP_0000689 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOP_0000689">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOP_0000646"/>
        <obo:IAO_0000115>A living polymerisation process where a transfer agent AX, reacts reversibly with an initiating radical R. or a propagating radical R(M)[n]. to give another transfer agent RX or R(M)[n]X and a species capable of initiating polymerisation.</obo:IAO_0000115>
