        <dc:date>11:05:2022 11:15</dc:date>
        <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOP is the molecular process ontology. It contains the molecular processes that underlie the name reaction ontology RXNO, for example cyclization, methylation and demethylation.</dc:description>
        <dc:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOP</dc:title>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <oboInOwl:hasOBOFormatVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.2</oboInOwl:hasOBOFormatVersion>
    </owl:Ontology>
    


