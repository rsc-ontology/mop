    <!-- http://purl.obolibrary.org/obo/MOP_0000615 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOP_0000615">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOP_0000543"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A process where an electron is transferred from one molecular entity or part of a molecular entity to a different molecular entity or part of the same molecular entity.</obo:IAO_0000115>
