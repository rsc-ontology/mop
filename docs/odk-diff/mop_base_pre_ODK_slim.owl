# Object Property: <http://purl.obolibrary.org/obo/MOP_0000769> (is_catalysis_of)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0001-5985-7429") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MOP_0000769> "x is_catalysis_of y if and only if x positively_regulates y and the positive regulation works by providing a more kinetically-favourable route across the energy landscape from the reactants of y to the products of y.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MOP_0000769> "MOP:0000769")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MOP_0000769> "is_catalysis_of")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/MOP_0000769> <http://purl.obolibrary.org/obo/RO_0002213>)



