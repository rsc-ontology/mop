    <!-- http://purl.obolibrary.org/obo/MOP_0000769 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/MOP_0000769">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002213"/>
        <obo:IAO_0000115>x is_catalysis_of y if and only if x positively_regulates y and the positive regulation works by providing a more kinetically-favourable route across the energy landscape from the reactants of y to the products of y.</obo:IAO_0000115>
        <oboInOwl:id>MOP:0000769</oboInOwl:id>
        <rdfs:label>is_catalysis_of</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MOP_0000769"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>x is_catalysis_of y if and only if x positively_regulates y and the positive regulation works by providing a more kinetically-favourable route across the energy landscape from the reactants of y to the products of y.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0001-5985-7429</oboInOwl:hasDbXref>
    </owl:Axiom>
    


